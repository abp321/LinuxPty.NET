<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>Porta.Pty</RootNamespace>
    <PackageId>LinuxPty.NET</PackageId>
    <Title>LinuxPty.NET</Title>
    <Description>Linux-only pseudoterminal library for .NET 10, derived from Porta.Pty.</Description>
    <Authors>abp321;Tom Laird-McConnell</Authors>
    <Copyright>Copyright (c) 2025 Tom Laird-McConnell; modifications copyright (c) 2026 abp321</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/abp321/LinuxPty.NET</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>pty;linux;terminal;pseudoterminal;dotnet</PackageTags>
    <RepositoryUrl>https://github.com/abp321/LinuxPty.NET</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <PropertyGroup>
    <_LinuxPtyNativeRoot>$(MSBuildThisFileDirectory)../Porta.Pty.Native/output/runtimes/</_LinuxPtyNativeRoot>
    <_LinuxPtyBuildRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</_LinuxPtyBuildRid>
    <_LinuxPtyBuildRid Condition="'$(_LinuxPtyBuildRid)' == ''">$(NETCoreSdkRuntimeIdentifier)</_LinuxPtyBuildRid>
    <_LinuxPtyBuildShim>$(_LinuxPtyNativeRoot)$(_LinuxPtyBuildRid)/native/libporta_pty.so</_LinuxPtyBuildShim>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="" />
    <None Include="../../LICENSE" Pack="true" PackagePath="" />
    <None Include="$(_LinuxPtyNativeRoot)linux-x64/native/libporta_pty.so"
          Pack="true"
          PackagePath="runtimes/linux-x64/native/"
          Condition="'$(_LinuxPtyBuildRid)' != 'linux-x64'" />
    <None Include="$(_LinuxPtyNativeRoot)linux-arm64/native/libporta_pty.so"
          Pack="true"
          PackagePath="runtimes/linux-arm64/native/"
          Condition="'$(_LinuxPtyBuildRid)' != 'linux-arm64'" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(_LinuxPtyBuildShim)')">
    <Content Include="$(_LinuxPtyBuildShim)"
             Pack="true"
             PackagePath="runtimes/$(_LinuxPtyBuildRid)/native/"
             Link="libporta_pty.so"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="ValidateLinuxPtyNativeAssets" BeforeTargets="Pack">
    <Error Condition="!Exists('$(_LinuxPtyNativeRoot)linux-x64/native/libporta_pty.so')"
           Text="The linux-x64 native PTY shim must be built before packing." />
    <Error Condition="!Exists('$(_LinuxPtyNativeRoot)linux-arm64/native/libporta_pty.so')"
           Text="The linux-arm64 native PTY shim must be built before packing." />
  </Target>
</Project>
